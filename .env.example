# ==============================================================================
# PaveSentry Environment Configuration Template (.env.example)
# Copy this file to .env and supply actual deployment values.
# DO NOT COMMIT SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
APP_NAME=PaveSentry
LOG_LEVEL=INFO

# ASGI Server Settings
HOST=0.0.0.0
PORT=9005
WORKERS=4

# JWT Security & Authentication
# Generate a secure 32+ byte key: openssl rand -hex 32
SECRET_KEY=change_me_to_a_secure_random_hex_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Primary Relational & Spatial Database
# For SQLite (default development/offline mode):
DATABASE_URL=sqlite:///./pavesentry.db
# For Enterprise PostgreSQL 16 + PostGIS (production container mode):
# DATABASE_URL=postgresql://pavesentry:your_secure_password@pavesentry-postgis:5432/pavesentry_db

# PostgreSQL / PostGIS Container Credentials
POSTGRES_USER=pavesentry
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=pavesentry_db
POSTGRES_HOST=pavesentry-postgis
POSTGRES_PORT=5432

# Redis Cache & Message Queue
REDIS_URL=redis://pavesentry-redis:6379/0

# Cross-Origin Resource Sharing (CORS)
# Comma-separated domains allowed to connect to API
CORS_ORIGINS=http://localhost:80,http://localhost:9005,http://127.0.0.1:9005

# External Weather & Sensor Integration (Optional)
# DELHI_WEATHER_API_KEY=
