# ==============================================================================
# PaveSentry Git Exclusion & Cyber-Security Quarantine Rules (.gitignore)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE / Editor metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
.rocketride/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
*.log

# Sensitive credentials & environment secrets (Never commit!)
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
*.p12

# Runtime SQLite databases, migration dumps & dynamic state
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
database/postgis_dump.sql
*.sql.dump

# User-uploaded files (keep folder structure intact with .gitkeep)
uploads/potholes/*
!uploads/potholes/.gitkeep
uploads/*
!uploads/potholes/

# Redundant archives & duplicate export folders
exported_models.zip
exported_models/

# Local submission packages (contains personal PII, duplicate code)
Submission/
Users/

# Temporary UI QA screenshots & media dumps
dashboard_screen.png
full_workspace_analytics.png
full_workspace_analytics_light.png
view_citizen_portal_light.png
workspace_screen_light.png
temp_test_stream.mp4
*.mp4

# Scratch scripts, duplicate datasets & evaluation CSV dumps
update_models_from_zip.py
generate_report_pdf.py
ppt_criteria.md
evaluation.md
test_phase_a_b.py
delhi_road_dataset.csv
model_comparison.csv
model_evaluation_results.csv
sample_predictions.csv
inspect_shapes.py
*.pptx
